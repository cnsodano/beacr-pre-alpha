    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{value}}{The object to hash. Ideally a \code{raw} byte vector. Any other
type will trigger an automatic conversion attempt via \code{to_raw()} (see
Warnings).}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A \code{raw} vector containing the hash digest of \code{value}, with
