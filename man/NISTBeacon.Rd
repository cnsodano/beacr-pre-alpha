\subsection{\code{NISTBeacon$validate_pulse()}}{
  Validate the integrity of a pulse by checking its chain linkage.

Performs two checks against the pulse immediately preceding the
one supplied:
\enumerate{
\item \strong{Previous-value check} — confirms that the \code{"previous"} entry in
the current pulse's \code{listValues} matches the \code{outputValue} of the
actual prior pulse fetched from the API.
\item \strong{Pre-commitment check} — confirms that hashing the current pulse's
\code{localRandomValue} reproduces the \code{precommitmentValue} that was
published in the prior pulse. This is essential to proving there has
been no tampering in between pulses
}
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{NISTBeacon$validate_pulse(pulse)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{pulse}}{A named \code{list} as returned by \code{get_latest_pulse()},
\code{get_pulse_by_index()}, or \code{get_pulse_by_timestamp()}. Must contain at minimum
the fields \verb{$chainIndex}, \verb{$pulseIndex}, \verb{$outputValue},
\verb{$localRandomValue}, and \verb{$listValues}.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    \code{TRUE} (invisibly) if both checks pass, or if \code{pulseIndex == 1}
(see Warnings). Never returns \code{FALSE}; failure always raises an error.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{beacon <- NISTBeacon$new()
pulse <- beacon$get_latest_pulse()

# Validate a pulse before using its output
beacon$validate_pulse(pulse)

# Validate a historical pulse
old_pulse <- beacon$get_pulse_by_index(chain_index = 1, pulse_index = 100)
beacon$validate_pulse(old_pulse)
}
    \if{html}{\out{</div>}}
  }
}

