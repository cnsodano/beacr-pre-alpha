\subsection{\code{NISTBeacon$get_latest_pulse()}}{
  Fetch the most recent pulse from a given chain.

Makes a \code{GET} request to \verb{<api_base_url>/chain/<chain>/pulse/last} and
returns the parsed pulse object. No validation is performed; call
\code{validate_pulse()} on the result if integrity checking is required.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{NISTBeacon$get_latest_pulse(chain = "last")}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{chain}}{\code{character(1)} or \code{numeric(1)}. The chain to query.
Accepts either a numeric chain index or the special string \code{"last"}
(default), which resolves to the most recently active chain.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A named \code{list} representing the pulse object as returned by the
NIST Beacon API. Key fields include:
\itemize{
\item \verb{$outputValue} — the hex-encoded random output for this pulse.
\item \verb{$chainIndex} — the index of the chain this pulse belongs to.
\item \verb{$pulseIndex} — the position of this pulse within its chain.
\item \verb{$precommitmentValue} — a hash commitment to the \emph{next} pulse's
local random value, used for forward-validation.
\item \verb{$listValues} — a data frame of previous pulses' \code{outputValue}
includes the columns "uri" (to make the HTTP request to retrieve
that pulse), "type" (e.g. \code{previous}, \code{year}, \code{month}, \code{day} or
\code{hour}. NIST v2.0 has a pulse period of 60 seconds, so \code{previous}
is the same as '1 minute ago')
}
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{beacon <- NISTBeacon$new()

# Fetch from the most recent chain
pulse <- beacon$get_latest_pulse()
pulse$outputValue

# Fetch from a specific chain
pulse <- beacon$get_latest_pulse(chain = 1)
}
    \if{html}{\out{</div>}}
  }
}

